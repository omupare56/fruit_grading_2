# ═══════════════════════════════════════════════════════════════════════════════
# FruitVision DL — Environment Variables
# Copy this file to .env and fill in your values before running.
# NEVER commit your actual .env file to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Required for user auth and prediction history persistence.
# Create a free cluster at https://cloud.mongodb.com
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/fruit_quality_db?retryWrites=true&w=majority
MONGODB_URI=

# ── JWT Authentication ─────────────────────────────────────────────────────────
# REQUIRED: Change to a long random secret in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ── ML Backend (Python Flask) URL ─────────────────────────────────────────────
# REQUIRED for predictions to work.
# Local dev:   http://localhost:5000
# Production:  https://your-ml-service.railway.app  (or render/etc.)
PYTHON_ML_URL=http://localhost:5000

# ── Internal ML Secret ────────────────────────────────────────────────────────
# Shared secret between Node.js and Python ML service.
# Both services must use the same value.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ML_INTERNAL_SECRET=change_this_to_a_random_string_shared_between_node_and_python

# ── Model Weight Paths (Python ML Service) ────────────────────────────────────
# Default paths — only change if you move the files.
YOLO_MODEL_PATH=models/yolo/best.pt
EFFICIENTNET_MODEL_PATH=models/efficientnet/efficientnet_v2.pth

# ── Model Download URLs (used by scripts/download_models.py) ──────────────────
# Set these to download your trained weights automatically.
# Supports: direct HTTPS URL, hf://owner/repo/file.pt, or local /path/to/file
# Leave empty if you will manually copy weights to models/ directory.
YOLO_MODEL_DOWNLOAD_URL=
EFFICIENTNET_MODEL_DOWNLOAD_URL=

# ── Demo Mode (disabled by default) ───────────────────────────────────────────
# Set to true ONLY for academic presentation demo without real AI weights.
# When false (default), real ML inference is required for predictions.
DEMO_MODE=false

# ── Application Environment ───────────────────────────────────────────────────
NODE_ENV=development
FLASK_ENV=development

# ── Server Port (optional, defaults shown) ────────────────────────────────────
PORT=3000          # Node.js server port
# PORT=5000        # Python Flask port (set in a second terminal or .env.python)

# ── CORS (Python Flask service) ───────────────────────────────────────────────
# Set to your Vercel frontend URL in production.
# ALLOWED_ORIGINS=https://your-app.vercel.app
