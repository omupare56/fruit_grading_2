# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/fruit_quality_db?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for authenticating /api/* sessions
JWT_SECRET=fruitvision_dl_super_secret_jwt_key_2026_change_in_production

# Model Weights File Paths (Optional override; defaults to models/yolo/best.pt and models/efficientnet/efficientnet_v2.pth)
YOLO_MODEL_PATH=models/yolo/best.pt
EFFICIENTNET_MODEL_PATH=models/efficientnet/efficientnet_v2.pth

# Review Demo Mode (Set to true to activate academic presentation demo mode when AI model weights are not loaded)
DEMO_MODE=true

# Application Environment (production / development)
NODE_ENV=production
FLASK_ENV=production
